# ==============================================================================
# Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DIRECT EMAIL DELIVERY (RECOMMENDED — NO DATABASE NEEDED)
# ------------------------------------------------------------------------------
# Where you want to receive client project inquiries:
OWNER_EMAIL=naganobiea@gmail.com

# OPTION A: Resend (Free 3,000 emails/mo at https://resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# OPTION B: Gmail SMTP via App Password (Use if you prefer Gmail directly)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-char-app-password

# ------------------------------------------------------------------------------
# 2. ADMIN DASHBOARD & SITE CONFIG
# ------------------------------------------------------------------------------
ADMIN_DASHBOARD_PASSWORD=choose-a-strong-password
NEXT_PUBLIC_SITE_URL=https://freelance-kappa-orpin.vercel.app

# ------------------------------------------------------------------------------
# 3. SUPABASE (OPTIONAL — Leave empty if using direct email)
# ------------------------------------------------------------------------------
# Set DISABLE_SUPABASE=true if you have old Supabase variables on Vercel
# and want to ensure the app runs in pure email mode without Supabase errors.
# DISABLE_SUPABASE=true
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
